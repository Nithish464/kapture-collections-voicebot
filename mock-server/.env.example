# Port the mock webhook server listens on.
PORT=3000

# --- Not used by the mock logic itself, but shown here for the "production swap-in" path ---
# SMS/WhatsApp provider (e.g. Twilio, Gupshup) — would replace the mocked send_payment_link response.
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_FROM_NUMBER=

# CRM / escalation queue (e.g. Freshdesk, Zendesk, internal ticketing) — would replace the mocked
# escalate_to_agent ticket_id generation.
# CRM_API_KEY=
# CRM_QUEUE_ID=

# Optional shared secret to verify inbound requests are genuinely from Vapi.
# VAPI_WEBHOOK_SECRET=
